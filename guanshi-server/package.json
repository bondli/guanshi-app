{
  "name": "guanshi-server",
  "version": "0.1.0",
  "private": true,
  "description": "管事云端：Agent、Duty、定时调度与推送分发",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "config": "node -e \"const c=require('./dist/config');console.log(c.config)\"",
    "reset": "node -e \"require('fs').rmSync(require('os').homedir()+'/.guanshi-app/data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lunar-javascript": "^1.7.8",
    "node-cron": "^3.0.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
