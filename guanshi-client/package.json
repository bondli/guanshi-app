{
  "name": "guanshi-client",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && expo export --platform android",
    "pack": "expo prebuild --platform android --no-install && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.13",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "^58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
